{
	"file_scan_exclusions": [
		"**/__pycache__",
		"**/.pytest_cache",
		"**/.ruff_cache",
		"**/.mypy_cache",
		"..."
	],
	"languages": {
		"Python": {
			"tab_size": 4,
			"hard_tabs": false,
			"language_servers": ["ty", "ruff", "!basedpyright"],
			"formatter": {
				"language_server": {
					"name": "ruff"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.ruff": true,
				"source.organizeImports.ruff": true
			}
		},
		"Django": {
			"tab_size": 4,
			"language_servers": ["djls", "!django-template-lsp", "..."],
			"formatter": {
				"external": {
					"command": "uv",
					"arguments": [
						"run",
						"--no-sync",
						"djangofmt",
						"--stdin-filename",
						"{buffer_path}"
					]
				}
			}
		}
	},
	"lsp": {
		"ruff": {
			"binary": {
				"path": "uv",
				"arguments": ["run", "--no-sync", "ruff", "server"]
			}
		},
		"ty": {
			"binary": {
				"path": "uv",
				"arguments": ["run", "--no-sync", "ty", "server"]
			}
		}
	}
}
